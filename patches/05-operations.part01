+def _run_quiet(argv: list[str]) -> bool:
+    """Best-effort cleanup command that must not mask the primary failure."""
+    try:
+        proc = subprocess.run(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
+        return proc.returncode == 0
+    except OSError:
+        return False
+
+
+def _rmdir_if_empty(path: str) -> None:
+    """Remove only an empty directory; never recurse across a mountpoint."""
+    try:
+        os.rmdir(path)
+    except OSError:
+        pass
+
