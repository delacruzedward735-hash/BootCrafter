+def _snapshot_image_stream(
+    snapshot: SourceSnapshot,
+) -> tuple[BinaryIO | _ZipImageStream | _ProcessImageStream | _OwnedImageStream, int | None, str]:
+    lower = snapshot.path.lower()
+    if lower.endswith(".gz"):
+        backing = snapshot.open_file()
+        return _OwnedImageStream(gzip.GzipFile(fileobj=backing, mode="rb"), backing), None, "gzip"
+    if lower.endswith(".xz"):
+        backing = snapshot.open_file()
+        return _OwnedImageStream(lzma.LZMAFile(backing, mode="rb"), backing), None, "xz"
+    if lower.endswith(".bz2"):
+        backing = snapshot.open_file()
+        return _OwnedImageStream(bz2.BZ2File(backing, mode="rb"), backing), None, "bzip2"
+    if lower.endswith(".zip"):
+        backing = snapshot.open_file()
+        try:
+            archive = zipfile.ZipFile(backing, "r")
+            members = [m for m in archive.infolist() if not m.is_dir()]
+            candidates = [m for m in members if m.filename.lower().endswith(SUPPORTED_ZIP_IMAGE_SUFFIXES)]
+            if len(candidates) != 1:
+                archive.close()
+                backing.close()
+                raise ValueError("ZIP images must contain exactly one ISO/IMG/RAW/BIN file.")
+            member = candidates[0]
+            return _ZipImageStream(archive, archive.open(member, "r"), backing), member.file_size, "zip"
+        except Exception:
+            if not backing.closed:
+                backing.close()
+            raise
+    if lower.endswith((".zst", ".zstd")):
+        zstd = require_command("zstd")
+        backing = snapshot.open_file()
+        stderr_file = tempfile.TemporaryFile(mode="w+b")
+        try:
+            proc = subprocess.Popen([zstd, "-dc"], stdin=backing, stdout=subprocess.PIPE, stderr=stderr_file)
+        except Exception:
+            backing.close()
+            stderr_file.close()
+            raise
+        backing.close()
+        return _ProcessImageStream(proc, stderr_file), None, "zstd"
+    return snapshot.open_file(), snapshot.size, "raw"
+
