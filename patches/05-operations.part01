+class _OwnedImageStream:
+    def __init__(self, stream: BinaryIO, backing: BinaryIO) -> None:
+        self.stream = stream
+        self.backing = backing
+
+    def read(self, size: int = -1) -> bytes:
+        return self.stream.read(size)
+
+    def close(self) -> None:
+        try:
+            self.stream.close()
+        finally:
+            if self.backing is not self.stream:
+                self.backing.close()
+
+    def __enter__(self) -> "_OwnedImageStream":
+        return self
+
+    def __exit__(self, exc_type, exc, tb) -> None:
+        self.close()
+
