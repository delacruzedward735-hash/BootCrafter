+    def test_nonrecursive_cleanup_never_deletes_mounted_style_contents(self):
+        with tempfile.TemporaryDirectory() as root:
+            mountpoint = os.path.join(root, "usb")
+            os.mkdir(mountpoint)
+            sentinel = os.path.join(mountpoint, "keep-me")
+            with open(sentinel, "w", encoding="utf-8") as f:
+                f.write("data")
+            _rmdir_if_empty(mountpoint)
+            self.assertTrue(os.path.isfile(sentinel))
+
+    @mock.patch("bootcrafter_linux.operations.unmount_device")
+    @mock.patch("bootcrafter_linux.operations._check_block_device")
+    @mock.patch("bootcrafter_linux.operations.require_root")
+    @mock.patch("bootcrafter_linux.operations.validate_target_device")
+    def test_mbr_format_over_2tib_rejected_before_unmount(self, validate, _root, _block, unmount):
+        with tempfile.NamedTemporaryFile(delete=False) as target:
+            target_path = target.name
+        validate.return_value = Device(
+            target_path, MBR_MAX_SAFE_BYTES + 1, "Large USB", "V", "usb", True, True, False, False, "S"
+        )
+        try:
+            with self.assertRaisesRegex(ValueError, "2 TiB"):
+                format_drive(target_path, "mbr", "fat32", "TEST")
+            unmount.assert_not_called()
+        finally:
+            os.unlink(target_path)
+
     @mock.patch("bootcrafter_linux.operations._clear_stale_target_tail")
     @mock.patch("bootcrafter_linux.operations.unmount_device")
     @mock.patch("bootcrafter_linux.operations.ensure_source_not_on_target")
