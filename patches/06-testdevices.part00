+    def test_internal_mmc_transport_is_not_listed_without_removable_or_hotplug(self):
+        payload = json.dumps({"blockdevices": [
+            {"path": "/dev/mmcblk0", "type": "disk", "size": 128000000000, "tran": "mmc",
+             "rm": False, "hotplug": False, "ro": False, "model": "Internal eMMC"},
+            {"path": "/dev/mmcblk1", "type": "disk", "size": 64000000000, "tran": "mmc",
+             "rm": True, "hotplug": True, "ro": False, "model": "SD Card"},
+        ]})
+        self.assertEqual([d.path for d in parse_lsblk(payload)], ["/dev/mmcblk1"])
+
