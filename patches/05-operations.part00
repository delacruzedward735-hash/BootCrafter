+def _invoking_uid() -> int | None:
+    """Return the desktop user's uid when the helper was elevated."""
+    for key in ("PKEXEC_UID", "SUDO_UID"):
+        raw = os.environ.get(key, "").strip()
+        if raw.isdigit():
+            uid = int(raw)
+            if uid >= 0:
+                return uid
+    return None
+
+
+def _uid_groups(uid: int) -> set[int]:
+    try:
+        entry = pwd.getpwuid(uid)
+    except KeyError:
+        return set()
+    groups = {entry.pw_gid}
+    try:
+        groups.update(os.getgrouplist(entry.pw_name, entry.pw_gid))
+    except (AttributeError, OSError):
+        for record in grp.getgrall():
+            if entry.pw_name in record.gr_mem:
+                groups.add(record.gr_gid)
+    return groups
+
+
+def _source_mode_readable_by_uid(st: os.stat_result, uid: int) -> bool:
+    if uid == 0:
+        return True
+    mode = st.st_mode
+    if st.st_uid == uid:
+        return bool(mode & stat.S_IRUSR)
+    if st.st_gid in _uid_groups(uid):
+        return bool(mode & stat.S_IRGRP)
+    return bool(mode & stat.S_IROTH)
+
+
+@dataclass
+class SourceSnapshot:
+    """Stable open source image used by the privileged helper.
+
+    Keeping the inode open prevents a user-writable source path from being
+    swapped to another file after authorization but before the destructive
+    operation starts.
+    """
+
+    path: str
+    fd: int
+    size: int
+
+    @property
+    def proc_path(self) -> str:
+        return f"/proc/{os.getpid()}/fd/{self.fd}"
+
+    def open_file(self) -> BinaryIO:
+        # Opening our proc fd creates a fresh file description with its own
+        # offset while still referring to the exact inode captured above.
+        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
+        dup_fd = os.open(self.proc_path, flags)
+        return os.fdopen(dup_fd, "rb", buffering=0)
+
+    def close(self) -> None:
+        if self.fd >= 0:
+            os.close(self.fd)
+            self.fd = -1
+
+    def __enter__(self) -> "SourceSnapshot":
+        return self
+
+    def __exit__(self, exc_type, exc, tb) -> None:
+        self.close()
+
+
+def open_source_snapshot(path: str) -> SourceSnapshot:
+    source = os.path.realpath(path)
+    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
+    try:
+        fd = os.open(source, flags)
+    except OSError as exc:
+        raise PermissionError(f"Cannot open selected image safely: {source}") from exc
+    try:
