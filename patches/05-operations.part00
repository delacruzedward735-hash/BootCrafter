+    """Resolve privileged helpers only from trusted system directories.
+
+    Never honor a desktop/user PATH here: this module also runs as root via
+    pkexec, so PATH lookup would turn a user-writable executable into a
+    privilege-escalation surface.
+    """
+    if not name or "/" in name:
+        return None
+    for directory in TRUSTED_COMMAND_DIRS:
         candidate = os.path.join(directory, name)
         if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
             return candidate
