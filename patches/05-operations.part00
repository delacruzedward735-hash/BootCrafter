 def emit(event: str, **data) -> None:
-    print(json.dumps({"event": event, **data}, separators=(",", ":")), flush=True)
+    """Emit helper progress without making UI-pipe failure destructive.
+
+    The privileged helper must keep completing a disk write even if the GUI is
+    killed, the desktop session crashes, or the stdout pipe disappears.
+    """
+    try:
+        print(json.dumps({"event": event, **data}, separators=(",", ":")), flush=True)
+    except (BrokenPipeError, OSError):
+        # Progress reporting is best-effort; disk integrity is not. Replace the
+        # broken stream so Python does not fail again while flushing stdout at
+        # interpreter shutdown (which would otherwise turn a successful write
+        # into a non-zero helper exit status).
+        try:
+            sys.stdout = open(os.devnull, "w")
+        except OSError:
+            pass
+        return
 
 
